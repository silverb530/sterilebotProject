<Application x:Class="monitoring_wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ══ 밝은 팔레트 ══ -->
        <!-- 페이지 배경 -->
        <Color x:Key="PageBgC">#EEF3FA</Color>
        <!-- 헤더/사이드바 (중간 네이비 — 읽기 쉬운 밝기) -->
        <Color x:Key="NavyDeepC">#1E3A5F</Color>
        <Color x:Key="NavyMidC">#2A4F7A</Color>
        <Color x:Key="NavySurfaceC">#3B6EA8</Color>
        <Color x:Key="NavyBorderC">#4A7BBF</Color>
        <!-- 카드 / 패널 -->
        <Color x:Key="CardBgC">#FFFFFF</Color>
        <Color x:Key="CardHeaderC">#F0F6FF</Color>
        <Color x:Key="BorderLightC">#CBD5E1</Color>
        <!-- 강조 -->
        <Color x:Key="AccentBlueC">#2563EB</Color>
        <Color x:Key="AccentGlowC">#1D4ED8</Color>
        <Color x:Key="TealC">#0D9488</Color>
        <!-- 상태 -->
        <Color x:Key="GreenOkC">#16A34A</Color>
        <Color x:Key="AmberWarnC">#D97706</Color>
        <Color x:Key="DangerC">#DC2626</Color>
        <Color x:Key="EmergCyanC">#0891B2</Color>
        <!-- 텍스트 -->
        <Color x:Key="TextDarkC">#1E293B</Color>
        <Color x:Key="TextMidC">#475569</Color>
        <Color x:Key="TextDimC">#94A3B8</Color>
        <Color x:Key="TextWhiteC">#F0F4FF</Color>
        <Color x:Key="TextNavyC">#1E3A5F</Color>

        <!-- 브러시 -->
        <SolidColorBrush x:Key="PageBg"      Color="{StaticResource PageBgC}"/>
        <SolidColorBrush x:Key="NavyDeep"    Color="{StaticResource NavyDeepC}"/>
        <SolidColorBrush x:Key="NavyMid"     Color="{StaticResource NavyMidC}"/>
        <SolidColorBrush x:Key="NavySurface" Color="{StaticResource NavySurfaceC}"/>
        <SolidColorBrush x:Key="NavyBorder"  Color="{StaticResource NavyBorderC}"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="{StaticResource AccentBlueC}"/>
        <SolidColorBrush x:Key="TealBrush"   Color="{StaticResource TealC}"/>
        <SolidColorBrush x:Key="GreenOk"     Color="{StaticResource GreenOkC}"/>
        <SolidColorBrush x:Key="AmberWarn"   Color="{StaticResource AmberWarnC}"/>
        <SolidColorBrush x:Key="DangerRed"   Color="{StaticResource DangerC}"/>
        <SolidColorBrush x:Key="EmergCyan"   Color="{StaticResource EmergCyanC}"/>
        <SolidColorBrush x:Key="TextDark"    Color="{StaticResource TextDarkC}"/>
        <SolidColorBrush x:Key="TextMid"     Color="{StaticResource TextMidC}"/>
        <SolidColorBrush x:Key="TextDim"     Color="{StaticResource TextDimC}"/>
        <SolidColorBrush x:Key="TextWhite"   Color="{StaticResource TextWhiteC}"/>
        <SolidColorBrush x:Key="WhiteBrush"  Color="White"/>
        <SolidColorBrush x:Key="BorderLight" Color="{StaticResource BorderLightC}"/>

        <!-- ══ 버튼 스타일 ══ -->

        <!-- 기본 아웃라인 버튼 -->
        <Style x:Key="NavyOutlineBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource NavyDeep}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource NavyDeep}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Width"           Value="120"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C8DCFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 강조 파란 버튼 -->
        <Style x:Key="NavyFilledBtn" TargetType="Button" BasedOn="{StaticResource NavyOutlineBtn}">
            <Setter Property="Background"  Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
        </Style>

        <!-- 비상정지 버튼 -->
        <Style x:Key="EmergencyBtn" TargetType="Button" BasedOn="{StaticResource NavyOutlineBtn}">
            <Setter Property="Background"  Value="#FEF2F2"/>
            <Setter Property="Foreground"  Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>

        <!-- ══ 카드 스타일 ══ -->
        <Style x:Key="WhiteCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="NavyCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource NavyMid}"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderBrush"     Value="{StaticResource NavyBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Application.Resources>
</Application>
