<Window x:Class="monitoring_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:monitoring_wpf.Views"
        Title="SterileBot Monitor"
        Height="760" Width="1366"
        WindowState="Maximized"
        Background="#0B1929">

    <Grid>
        <views:FaceAuthView  x:Name="ViewFaceAuth"  Visibility="Visible"/>
        <views:MainView      x:Name="ViewMain"      Visibility="Collapsed"/>
        <views:DriveTestView x:Name="ViewDriveTest" Visibility="Collapsed"/>
        <views:RunningView   x:Name="ViewRunning"   Visibility="Collapsed"/>
    </Grid>

</Window>
