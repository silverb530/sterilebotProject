<UserControl x:Class="monitoring_wpf.Views.FaceAuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 전체 배경: 진한 네이비 -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EEF3FA" Offset="0"/>
                <GradientStop Color="#E8F2FF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 배경 원형 장식 -->
        <Ellipse Width="600" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,-200,0,0" Opacity="0.04">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2B7FFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- 로고 텍스트 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="CHEMI" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                           Foreground="#2B7FFF"/>
                <TextBlock Text="BOT" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                           Foreground="#6B85A8"/>
            </StackPanel>
            <TextBlock Text="사용자 인증" FontFamily="Segoe UI" FontSize="13"
                       Foreground="#6B85A8" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <!-- 카메라 카드 -->
            <Border Width="560" Height="420" CornerRadius="14"
                    Background="#FFFFFF" BorderThickness="1.5">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="CardBorderBrush" Color="#CBD5E1"/>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#2B7FFF" BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
                </Border.Effect>

                <Grid ClipToBounds="True">

                    <!-- ① 카메라 피드 -->
                    <Image x:Name="CameraImage" Stretch="UniformToFill"/>

                    <!-- ② 카메라 없을 때 플레이스홀더 -->
                    <Grid x:Name="NoCamPlaceholder" Visibility="Collapsed">
                        <Rectangle Fill="#080F1C"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="카메라를 연결해 주세요" FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#6B85A8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ③ 스캔 라인 애니메이션 -->
                    <Rectangle x:Name="ScanLine" Height="2" VerticalAlignment="Top"
                               Margin="0,0,0,0" Opacity="0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#2B7FFF" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanTranslate" Y="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- ④ 얼굴 감지 브라켓 (Canvas 오버레이) -->
                    <Canvas x:Name="BracketCanvas" Width="560" Height="420">
                        <!-- 좌상단 코너 -->
                        <Line x:Name="BL_V1" X1="140" Y1="80"  X2="140" Y2="148"
                              Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BL_H1" X1="140" Y1="80"  X2="208" Y2="80"
                              Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <!-- 우상단 코너 -->
                        <Line x:Name="BR_V1" X1="420" Y1="80"  X2="420" Y2="148"
                              Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BR_H1" X1="352" Y1="80"  X2="420" Y2="80"
                              Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <!-- 좌하단 코너 -->
                        <Line x:Name="BL_V2" X1="140" Y1="340" X2="140" Y2="272"
                              Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BL_H2" X1="140" Y1="340" X2="208" Y2="340"
                              Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <!-- 우하단 코너 -->
                        <Line x:Name="BR_V2" X1="420" Y1="340" X2="420" Y2="272"
                              Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BR_H2" X1="352" Y1="340" X2="420" Y2="340"
                              Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                        <!-- 인증 완료 체크 (기본 숨김) -->
                        <Border x:Name="AuthBadge" Visibility="Collapsed"
                                Canvas.Left="196" Canvas.Top="176"
                                Background="#15803D" CornerRadius="8" Padding="18,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓ " Foreground="White" FontSize="16" FontWeight="Bold"
                                           FontFamily="Segoe UI"/>
                                <TextBlock x:Name="AuthBadgeText" Text="인증 완료"
                                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Canvas>

                    <!-- ⑤ 하단 그라디언트 오버레이 -->
                    <Rectangle Height="110" VerticalAlignment="Bottom">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent"  Offset="0"/>
                                <GradientStop Color="#E0030E1E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- ⑥ 하단 상태 텍스트 -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock x:Name="AuthLine1" Text="얼굴 인식 중..."
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AuthLine2" Text=""
                                   FontFamily="Segoe UI" FontSize="13"
                                   Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- 하단 도움말 -->
            <TextBlock Text="얼굴을 카메라 중앙에 위치시켜 주세요"
                       FontFamily="Segoe UI" FontSize="12"
                       Foreground="#4A6280" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
