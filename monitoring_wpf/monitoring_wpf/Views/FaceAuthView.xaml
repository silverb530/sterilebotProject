<UserControl x:Class="monitoring_wpf.Views.FaceAuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EEF3FA" Offset="0"/>
                <GradientStop Color="#E8F2FF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="CHEMI" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Foreground="#2B7FFF"/>
                <TextBlock Text="BOT" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Foreground="#6B85A8"/>
            </StackPanel>
            <TextBlock Text="Auth" FontFamily="Segoe UI" FontSize="13" Foreground="#6B85A8" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Border Width="560" Height="420" CornerRadius="14" Background="#FFFFFF" BorderThickness="1.5">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="CardBorderBrush" Color="#CBD5E1"/>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#2B7FFF" BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <Image x:Name="CameraImage" Stretch="UniformToFill"/>
                    <Grid x:Name="NoCamPlaceholder" Visibility="Collapsed">
                        <Rectangle Fill="#080F1C"/>
                        <TextBlock Text="No Camera" FontFamily="Segoe UI" FontSize="13" Foreground="#6B85A8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle x:Name="ScanLine" Height="2" VerticalAlignment="Top" Opacity="0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#2B7FFF" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanTranslate" Y="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Canvas x:Name="BracketCanvas" Width="560" Height="420">
                        <Line x:Name="BL_V1" X1="140" Y1="80" X2="140" Y2="148" Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BL_H1" X1="140" Y1="80" X2="208" Y2="80" Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BR_V1" X1="420" Y1="80" X2="420" Y2="148" Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BR_H1" X1="352" Y1="80" X2="420" Y2="80" Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BL_V2" X1="140" Y1="340" X2="140" Y2="272" Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BL_H2" X1="140" Y1="340" X2="208" Y2="340" Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BR_V2" X1="420" Y1="340" X2="420" Y2="272" Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="BR_H2" X1="352" Y1="340" X2="420" Y2="340" Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Border x:Name="AuthBadge" Visibility="Collapsed" Canvas.Left="180" Canvas.Top="176" Background="#15803D" CornerRadius="8" Padding="18,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="V " Foreground="White" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="AuthBadgeText" Text="Auth OK" Foreground="White" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                    <Rectangle Height="110" VerticalAlignment="Bottom">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#E0030E1E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock x:Name="AuthLine1" Text="Scanning..." FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AuthLine2" Text="" FontFamily="Segoe UI" FontSize="13" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="ConfidencePanel" Visibility="Collapsed" Width="560" Margin="0,10,0,0" Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="#E2E8F0" Padding="18,10">
                <Border.Effect>
                    <DropShadowEffect Color="#1E3A5F" BlurRadius="12" ShadowDepth="0" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ConfidenceStatus" Text="Scanning..." FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <Border Height="8" CornerRadius="4" Background="#F1F5F9" Width="200" HorizontalAlignment="Left">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,200,8" RadiusX="4" RadiusY="4"/>
                            </Border.Clip>
                            <Rectangle x:Name="ConfidenceFill" Width="0" HorizontalAlignment="Left" RadiusX="4" RadiusY="4">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="#3B82F6"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ConfidencePercent" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>