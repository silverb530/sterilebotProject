<Window x:Class="monitoring_wpf.Views.ResumeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실험 재개 확인" Width="640" Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="20" BorderThickness="1" BorderBrush="#2A4F7A">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1E3A5F" Offset="0"/>
                <GradientStop Color="#15293F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단 강조선 -->
            <Border Grid.Row="0" Height="5" VerticalAlignment="Top" CornerRadius="20,20,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#60A5FA" Offset="0.5"/>
                        <GradientStop Color="#1E3A5F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="40,20,40,30">

                <!-- 체크 아이콘 -->
                <Border Width="90" Height="90" CornerRadius="45"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#16A34A" Offset="0"/>
                            <GradientStop Color="#0F2747" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#22C55E" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <TextBlock Text="✓" FontSize="48" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 제목 -->
                <TextBlock Text="비상 상황이 해제되었습니다"
                           FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <TextBlock Text="실험을 계속하시겠습니까?"
                           FontFamily="Segoe UI" FontSize="17" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>

                <!-- 버튼 2개 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">

                    <!-- 계속 버튼 -->
                    <Button Content="계속" Click="Continue_Click"
                            Width="230" Height="90" Margin="0,30,14,0" Cursor="Hand"
                            Foreground="White" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="14" BorderThickness="2"
                                        BorderBrush="#22C55E">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#16A34A" Offset="0"/>
                                            <GradientStop Color="#15803D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#22C55E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 종료 버튼 -->
                    <Button Content="종료" Click="Exit_Click"
                            Width="230" Height="90" Margin="14,30,0,0" Cursor="Hand"
                            Foreground="White" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="14" BorderThickness="2"
                                        BorderBrush="#37536F" Background="#243B54">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#37536F"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- HOME 응시 안내 -->
                <Border Background="#142B45" CornerRadius="12" Margin="0,24,0,0" Padding="20,14">
                    <TextBlock FontFamily="Segoe UI" FontSize="20" Foreground="#94A3B8"
                               HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="'계속' 선택 후 " /><Run Text="HOME" FontWeight="Bold" Foreground="#60A5FA"/><Run Text=" 구역을 응시하면" /><LineBreak/><Run Text="로봇이 초기 위치로 돌아가 다시 선택할 수 있습니다" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
