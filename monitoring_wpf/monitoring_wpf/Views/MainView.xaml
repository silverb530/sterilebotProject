<UserControl x:Class="monitoring_wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:monitoring_wpf.Views">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EEF3FA" Offset="0"/>
                <GradientStop Color="#E0EAFA" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- ── 상단 헤더 바 ── -->
        <Border Grid.Row="0" Background="#1E3A5F"
                BorderBrush="#2A4F7A" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 로고 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CHEMI" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                               Foreground="#2B7FFF"/>
                    <TextBlock Text="BOT" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                               Foreground="#CBD5E1"/>
                    <TextBlock Text="  모니터" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>

                <!-- 연결 상태 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,7,0"/>
                    <TextBlock x:Name="ConnLabel" Text="서버 연결 중..."
                               FontFamily="Segoe UI" FontSize="12" Foreground="#F59E0B"/>
                </StackPanel>

                <!-- 사용자 + 시계 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2A4F7A" CornerRadius="20" Padding="14,5" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2B7FFF" Offset="0"/>
                                        <GradientStop Color="#00D4AA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="UserLabel" Text="--"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" Text="--:--:--"
                               FontFamily="Segoe UI Mono" FontSize="14"
                               Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 메인 콘텐츠: 카메라 두 개 나란히 ── -->
        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <!-- 실험실 조감캠 (더 넓게) -->
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <!-- 로봇암 카메라 -->
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ 좌: 실험실 조감캠 ══ -->
            <Border Grid.Column="0" Style="{StaticResource WhiteCard}" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <!-- 카드 헤더 -->
                    <Border VerticalAlignment="Top" CornerRadius="10,10,0,0"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                            Height="38" Panel.ZIndex="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/>
                            <TextBlock Text="실험실 조감캠"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <TextBlock Text="  ·  작업대 전체뷰"
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF"/>
                            <!-- 카메라 인덱스 힌트 (개발용) -->
                            <Border Background="#F0F9FF" CornerRadius="4" Padding="6,1"
                                    Margin="10,0,0,0">
                                <TextBlock Text="CAM 2"
                                           FontFamily="Segoe UI Mono" FontSize="9" Foreground="#0284C7"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 카메라 피드 -->
                    <views:CameraFeedControl x:Name="LabCam" Margin="0,38,0,0"/>
                </Grid>
            </Border>

            <!-- ══ 우: 로봇암 카메라 ══ -->
            <Border Grid.Column="2" Style="{StaticResource WhiteCard}" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <!-- 카드 헤더 -->
                    <Border VerticalAlignment="Top" CornerRadius="10,10,0,0"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                            Height="38" Panel.ZIndex="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,7,0"/>
                            <TextBlock Text="손동작 카메라"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <Border Background="#FFF7E6" CornerRadius="4" Padding="6,1"
                                    Margin="10,0,0,0">
                                <TextBlock Text="CAM 1"
                                           FontFamily="Segoe UI Mono" FontSize="9" Foreground="#D97706"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 카메라 피드 -->
                    <views:CameraFeedControl x:Name="ArmCam" Margin="0,38,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ── 하단 상태바 ── -->
        <Border Grid.Row="2" Background="#1E3A5F"
                BorderBrush="#2A4F7A" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 상태 텍스트 -->
                <Border Grid.Column="0" Background="#0F2240" CornerRadius="8"
                        Padding="16,0" VerticalAlignment="Center" Height="44">
                    <TextBlock x:Name="StatusLabel"
                               Text="서버 연결 대기 중..."
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="White" VerticalAlignment="Center"/>
                </Border>

                <!-- 버튼 3개 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="구동 테스트" Style="{StaticResource NavyOutlineBtn}"
                            Margin="0,0,10,0" Click="DriveTest_Click"/>
                    <Button Content="실험 이력" Style="{StaticResource NavyOutlineBtn}"
                            Margin="0,0,10,0" Click="History_Click"/>
                    <Button Content="시  작" Style="{StaticResource NavyFilledBtn}"
                            Margin="0,0,10,0" Click="Start_Click"/>
                    <Button Content="로그아웃" Style="{StaticResource NavyOutlineBtn}"
                            Click="Exit_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
