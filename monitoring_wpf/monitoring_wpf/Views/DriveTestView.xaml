<UserControl x:Class="monitoring_wpf.Views.DriveTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 밝은 배경 -->
    <Grid Background="#EEF3FA">

        <!-- 배경 원형 장식 (연한 파랑) -->
        <Ellipse Width="600" Height="600"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,-100,0,0" Opacity="0.07">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- 로고 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                <TextBlock Text="CHEMI" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                           Foreground="#2563EB"/>
                <TextBlock Text="BOT" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- 메인 카드 -->
            <Border Width="540" Background="White" CornerRadius="14"
                    BorderBrush="#CBD5E1" BorderThickness="1" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#2563EB" BlurRadius="30" ShadowDepth="0" Opacity="0.10"/>
                </Border.Effect>
                <StackPanel>

                    <!-- 카드 헤더 (네이비) -->
                    <Border Background="#1E3A5F" CornerRadius="14,14,0,0"
                            Padding="24,18">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#2563EB" CornerRadius="6" Padding="10,4" Margin="0,0,14,0">
                                <TextBlock Text="TEST" FontFamily="Segoe UI" FontSize="10"
                                           FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="구동 테스트" FontFamily="Segoe UI" FontSize="17"
                                       FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 본문 -->
                    <StackPanel Margin="48,40,48,44">

                        <!-- 스피너 or 완료 아이콘 -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,28" Width="80" Height="80">
                            <!-- 배경 원 -->
                            <Ellipse Width="80" Height="80" Stroke="#E2E8F0" StrokeThickness="7"/>

                            <!-- 스피너 -->
                            <Ellipse x:Name="SpinnerArc" Width="80" Height="80"
                                     Stroke="#2563EB" StrokeThickness="7"
                                     StrokeDashArray="40 90">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="40" CenterY="40"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SpinnerRotate"
                                                    Storyboard.TargetProperty="Angle"
                                                    From="0" To="360"
                                                    Duration="0:0:1.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- 완료 체크 (기본 숨김) -->
                            <Border x:Name="CheckBadge" Visibility="Collapsed"
                                    Width="80" Height="80" CornerRadius="40"
                                    Background="#DCFCE7">
                                <TextBlock Text="✓" FontSize="32" FontWeight="Bold"
                                           Foreground="#16A34A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- 상태 텍스트 -->
                        <TextBlock x:Name="StatusTitle"
                                   Text="구동 테스트 중입니다"
                                   FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#1E293B" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatusSub"
                                   Text="잠시만 기다려 주세요..."
                                   FontFamily="Segoe UI" FontSize="14"
                                   Foreground="#64748B" HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <!-- 진행 바 -->
                        <Grid Margin="0,32,0,0">
                            <!-- 트랙 -->
                            <Border x:Name="ProgressTrack" Background="#E2E8F0"
                                    CornerRadius="5" Height="8">
                                <!-- 채움 -->
                                <Border x:Name="ProgressFill" Background="#2563EB"
                                        CornerRadius="5" HorizontalAlignment="Left"
                                        Width="0"/>
                            </Border>
                        </Grid>

                        <!-- 퍼센트 텍스트 -->
                        <TextBlock x:Name="ProgressPct" Text="0 %"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#64748B" HorizontalAlignment="Right"
                                   Margin="0,6,0,0"/>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 하단 안내 (고정) -->
            <TextBlock Text="테스트가 완료되면 자동으로 이동합니다"
                       FontFamily="Segoe UI" FontSize="12"
                       Foreground="#94A3B8" HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
