<Window x:Class="monitoring_wpf.Views.DriveTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="구동 테스트" Width="440" Height="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="20" BorderThickness="1" BorderBrush="#2A4F7A">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1E3A5F" Offset="0"/>
                <GradientStop Color="#15293F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단 파란 강조선 -->
            <Border Grid.Row="0" Height="5" VerticalAlignment="Top" CornerRadius="20,20,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#60A5FA" Offset="0.5"/>
                        <GradientStop Color="#1E3A5F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="36,20,36,26">

                <!-- 로봇팔 아이콘 -->
                <Border Width="84" Height="84" CornerRadius="42"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#1D4ED8" Offset="0"/>
                            <GradientStop Color="#0F2747" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <TextBlock Text="🦾" FontSize="40"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 제목 -->
                <TextBlock x:Name="TitleText" Text="구동 테스트"
                           FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>

                <!-- 현재 상태 카드 -->
                <Border Background="#142B45" CornerRadius="12" Margin="0,20,0,0" Padding="20,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="StepText" Text="테스트 준비 중..."
                                   FontFamily="Segoe UI" FontSize="13" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SlotText" Text=""
                                   FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                   Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="CountText" Text=""
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#64748B"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</Window>
