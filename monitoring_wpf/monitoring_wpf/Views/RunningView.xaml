<UserControl x:Class="monitoring_wpf.Views.RunningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:monitoring_wpf.Views">

    <!-- 밝은 배경 -->
    <Grid Background="#EEF3FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 상단 헤더 (중간 네이비) ══ -->
        <Border Grid.Row="0" Background="#1E3A5F"
                BorderBrush="#2A4F7A" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 상태 배지 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StateBadge" CornerRadius="5" Padding="12,4" Margin="0,0,10,0">
                        <Border.Background>
                            <SolidColorBrush x:Name="BadgeBg" Color="#15803D"/>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="BadgeDotColor" Color="#4ADE80"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="BadgeText" Text="실행중"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="BadgeFg" Color="#4ADE80"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="#2A4F7A" CornerRadius="4" Padding="7,3">
                        <TextBlock Text="ESC" FontFamily="Segoe UI Mono" FontSize="10"
                                   Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- 로고 중앙 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CHEMI" FontFamily="Segoe UI" FontSize="15"
                               FontWeight="Bold" Foreground="#60A5FA"/>
                    <TextBlock Text="BOT" FontFamily="Segoe UI" FontSize="15"
                               FontWeight="Bold" Foreground="#CBD5E1"/>
                    <TextBlock Text="  Monitor" FontFamily="Segoe UI" FontSize="12"
                               Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                </StackPanel>

                <!-- 시계 -->
                <TextBlock Grid.Column="2" x:Name="ClockText" Text="--:--:--"
                           FontFamily="Segoe UI Mono" FontSize="13"
                           Foreground="#CBD5E1" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ 메인 콘텐츠 ══ -->
        <Grid Grid.Row="1" Margin="14,12,14,12">
            <Grid.ColumnDefinitions>
                <!-- 카메라 영역 -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <!-- 사이드바 (밝게) -->
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════════════════ -->
            <!-- 왼쪽: 카메라 씬 (정상) / 비상 패널 (겹침)    -->
            <!-- ════════════════════════════════════════════ -->
            <Grid Grid.Column="0">

                <!-- ── 정상: PIP 카메라 레이아웃 ── -->
                <Border x:Name="ScenePanel" Style="{StaticResource WhiteCard}"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#1E3A5F" BlurRadius="16" ShadowDepth="0" Opacity="0.15"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 헤더 -->
                        <Border VerticalAlignment="Top" CornerRadius="10,10,0,0"
                                Background="#F0F6FF" BorderBrush="#CBD5E1"
                                BorderThickness="0,0,0,1" Height="36" Panel.ZIndex="1">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="14,0">
                                <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,7,0"/>
                                <TextBlock Text="실험실 작업 모니터링"
                                           FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#374151"/>
                                <TextBlock Text="  ·  클릭하여 카메라 전환"
                                           FontFamily="Segoe UI" FontSize="10"
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <!-- ── 카메라 영역 (PIP 오버레이) ── -->
                        <Grid Margin="0,36,0,0">

                            <!-- ① 메인 카메라 (풀사이즈, 클릭하면 스왑) -->
                            <Grid x:Name="MainCamGrid" Background="#070C14"
                                  Cursor="Hand"
                                  MouseLeftButtonDown="MainCam_Click">
                                <views:CameraFeedControl x:Name="MainCam"/>

                                <!-- 메인 카메라 라벨 (좌하단) -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                        Margin="12" Background="#CC000000" CornerRadius="6"
                                        Padding="10,5" Panel.ZIndex="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="MainDot" Width="7" Height="7" Fill="#4ADE80"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="MainLabelText" Text="실험실 조감캠"
                                                   FontFamily="Segoe UI" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- 스왑 힌트 (우하단 작게) -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                        Margin="12" Background="#80000000" CornerRadius="4"
                                        Padding="7,3" Panel.ZIndex="2">
                                    <TextBlock Text="⇄ 클릭하여 전환"
                                               FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#CBD5E1"/>
                                </Border>
                            </Grid>

                            <!-- ② PIP 카메라 (우상단, 클릭하면 스왑) -->
                            <Border x:Name="PipContainer"
                                    Width="300" Height="190"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,12,12,0"
                                    CornerRadius="8"
                                    BorderBrush="White" BorderThickness="2"
                                    Cursor="Hand"
                                    Panel.ZIndex="10"
                                    MouseLeftButtonDown="PipCam_Click"
                                    ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14"
                                                      ShadowDepth="0" Opacity="0.45"/>
                                </Border.Effect>
                                <Grid Background="#070C14">
                                    <views:CameraFeedControl x:Name="PipCam"/>

                                    <!-- PIP 라벨 (좌상단) -->
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                            Margin="8" Background="#CC000000" CornerRadius="4"
                                            Padding="7,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="PipDot" Width="6" Height="6"
                                                     Fill="#FB923C"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="PipLabelText" Text="손동작 카메라"
                                                       FontFamily="Segoe UI" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PIP 전환 힌트 (우상단) -->
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                            Margin="8" Background="#99000000" CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="⇄" FontSize="12" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── 비상 화면 (기본 숨김) ── -->
                <!-- ── 비상 화면 (기본 숨김) ── -->
                <Border x:Name="EmergencyPanel" Visibility="Collapsed" CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#1C0A00" Offset="0"/>
                            <GradientStop Color="#0A0A0A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#EF4444" BlurRadius="60" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 상단 빨간 강조선 -->
                        <Border Height="5" VerticalAlignment="Top" CornerRadius="12,12,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7F1D1D" Offset="0"/>
                                    <GradientStop Color="#EF4444" Offset="0.5"/>
                                    <GradientStop Color="#7F1D1D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">

                            <!-- 아이콘 원 (펄스 애니메이션) -->
                            <Border x:Name="PulseRing" Width="110" Height="110" CornerRadius="55"
                    HorizontalAlignment="Center" Margin="0,0,0,28">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#450A0A" Offset="0"/>
                                        <GradientStop Color="#1A0404" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PulseGlow" Color="#EF4444"
                                      BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation
                                    Storyboard.TargetName="PulseGlow"
                                    Storyboard.TargetProperty="BlurRadius"
                                    From="15" To="55" Duration="0:0:0.9"/>
                                                <DoubleAnimation
                                    Storyboard.TargetName="PulseGlow"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.4" To="1.0" Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <TextBlock Text="⚠" FontSize="52"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#EF4444"
                                       Margin="0,-8,0,0"/>
                            </Border>

                            <!-- 텍스트 -->
                            <TextBlock Text="EMERGENCY STOP"
                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                       Foreground="#7F1D1D" HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>
                            <TextBlock Text="비 상 상 황"
                       FontFamily="Segoe UI" FontSize="38" FontWeight="Bold"
                       Foreground="#EF4444" HorizontalAlignment="Center"/>
                            <TextBlock Text="시스템이 긴급 정지되었습니다"
                       FontFamily="Segoe UI" FontSize="14"
                       Foreground="#FCA5A5" HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

                            <!-- 구분선 -->
                            <Border Height="1" Margin="0,30,0,30">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#7F1D1D" Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- 버튼 -->
                            <Button Content="상태 초기화"
                    FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                    Foreground="White" Width="200" Height="50"
                    Cursor="Hand" Click="ResetState_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#B91C1C" Offset="0"/>
                                                    <GradientStop Color="#DC2626" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#EF4444" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.6"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#1E3A5F" BlurRadius="12" ShadowDepth="0" Opacity="0.08"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,8">

                    <!-- 비상정지 버튼 -->
                    <Border x:Name="EstopBorder" Margin="12,8,12,6" CornerRadius="8"
                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.5"
                            Cursor="Hand" Height="54"
                            MouseLeftButtonDown="EmergencyStop_Click">
                        <Border.Effect>
                            <DropShadowEffect Color="#DC2626" BlurRadius="8" ShadowDepth="0" Opacity="0.12"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="EstopIcon" Text="⚠" FontSize="16"
                                       Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EstopLabel" Text="비상 정지"
                                       FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#DC2626" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 일시정지 버튼 -->
                    <Border Margin="12,4,12,4" CornerRadius="8"
                            Background="#F0F6FF" BorderBrush="#CBD5E1" BorderThickness="1"
                            Height="46">
                        <Button x:Name="PauseResumeBtn" Background="Transparent" BorderThickness="0"
                                Height="46" Cursor="Hand" Click="PauseResume_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="8"
                                            Background="{TemplateBinding Background}">
                                        <TextBlock x:Name="t" Text="⏸  일시 정지"
                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#475569"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                            <Setter TargetName="t"  Property="Foreground"  Value="#1D4ED8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- 종료 버튼 -->
                    <Border Margin="12,4,12,4" CornerRadius="8"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                            Height="46">
                        <Button Background="Transparent" BorderThickness="0"
                                Height="46" Cursor="Hand" Click="Exit_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="8"
                                            Background="{TemplateBinding Background}">
                                        <TextBlock x:Name="t" Text="■  종료"
                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#475569"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                            <Setter TargetName="t"  Property="Foreground"  Value="#1E293B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- 리셋 버튼 -->
                    <Border Margin="12,4,12,4" CornerRadius="8"
                            Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1"
                            Height="46">
                        <Button Background="Transparent" BorderThickness="0"
                                Height="46" Cursor="Hand" Click="Reset_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="8"
                                            Background="{TemplateBinding Background}">
                                        <TextBlock x:Name="t" Text="↺  리셋"
                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#2563EB"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                            <Setter TargetName="t"  Property="Foreground"  Value="#1D4ED8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- 구분선 -->
                    <Border Height="1" Background="#E2E8F0" Margin="12,10,12,10"/>

                    <!-- 환경 센서 레이블 -->
                    <TextBlock Text="환경 센서" FontFamily="Segoe UI" FontSize="11"
                               Foreground="#64748B" Margin="16,0,0,10" FontWeight="SemiBold"/>

                    <!-- 가스 농도 -->
                    <Border Margin="12,3,12,3" Background="#F8FAFC"
                            BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="7" Padding="14,10">
                        <Grid>
                            <TextBlock Text="가스 농도"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#64748B" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="GasVal" Text="—"
                                           FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                           Foreground="#1E293B"/>
                                <TextBlock Text=" ppm" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 온도 -->
                    <Border Margin="12,3,12,3" Background="#F8FAFC"
                            BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="7" Padding="14,10">
                        <Grid>
                            <TextBlock Text="온도"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#64748B" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="TempVal" Text="—"
                                           FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                           Foreground="#1E293B"/>
                                <TextBlock Text=" °C" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 습도 -->
                    <Border Margin="12,3,12,12" Background="#F8FAFC"
                            BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="7" Padding="14,10">
                        <Grid>
                            <TextBlock Text="습도"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#64748B" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="HumVal" Text="—"
                                           FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                           Foreground="#1E293B"/>
                                <TextBlock Text=" %" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 안전 상태 칩 -->
                    <Border x:Name="StatusChip" Margin="12,0,12,0"
                            Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1"
                            CornerRadius="7" Padding="14,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse x:Name="SafetyDot" Width="8" Height="8" Fill="#16A34A"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusLabel" Text="안전"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#15803D"/>
                        </StackPanel>
                    </Border>

                    <!-- 구분선 -->
                    <Border Height="1" Background="#E2E8F0" Margin="12,10,12,10"/>

                    <!-- 현재 작업 상태 -->
                    <TextBlock Text="현재 작업 상태" FontFamily="Segoe UI" FontSize="11"
                               Foreground="#64748B" Margin="16,0,0,6" FontWeight="SemiBold"/>
                    <Border Margin="12,0,12,10" Background="#F8FAFC"
                            BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="7" Padding="14,10">
                        <StackPanel>
                            <TextBlock x:Name="WorkStatusText" Text="대기 중"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1E293B" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WorkStatusSub" Text="—"
                                       FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 구분선 -->
                    <Border Height="1" Background="#E2E8F0" Margin="12,0,12,6"/>

                    <!-- 실험실 배치도 -->
                    <TextBlock Text="실험실 배치도" FontFamily="Segoe UI" FontSize="11"
                               Foreground="#64748B" Margin="16,0,0,6" FontWeight="SemiBold"/>

                    <Border Margin="12,0,12,8" Background="#F8FAFC"
                            BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="7" Padding="4">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="280" Height="290">

                                <!-- ══ A 라벨 ══ -->
                                <TextBlock Canvas.Left="166" Canvas.Top="16" Text="시약대"
                                           FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <!-- A 거치대 배경 -->
                                <Border Canvas.Left="120" Canvas.Top="38" Width="150" Height="38"
                                        Background="#BFDBFE" CornerRadius="5"
                                        BorderBrush="#93C5FD" BorderThickness="1"/>
                                <Grid Canvas.Left="124" Canvas.Top="41" Width="32" Height="32">
                                    <Ellipse x:Name="SlotSyak1" Fill="#3B82F6" Stroke="#2563EB" StrokeThickness="1.5"/>
                                    <TextBlock Text="1" FontSize="12" FontFamily="Segoe UI" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Canvas.Left="160" Canvas.Top="41" Width="32" Height="32">
                                    <Ellipse x:Name="SlotSyak2" Fill="#3B82F6" Stroke="#2563EB" StrokeThickness="1.5"/>
                                    <TextBlock Text="2" FontSize="12" FontFamily="Segoe UI" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Canvas.Left="196" Canvas.Top="41" Width="32" Height="32">
                                    <Ellipse x:Name="SlotSyak3" Fill="#3B82F6" Stroke="#2563EB" StrokeThickness="1.5"/>
                                    <TextBlock Text="3" FontSize="12" FontFamily="Segoe UI" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
