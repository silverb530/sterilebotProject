<Window x:Class="monitoring_wpf.Views.VentingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환기 중" Width="600" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="20" BorderThickness="1" BorderBrush="#2A4F7A">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1E3A5F" Offset="0"/>
                <GradientStop Color="#15293F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단 파란 강조선 -->
            <Border Grid.Row="0" Height="5" VerticalAlignment="Top" CornerRadius="20,20,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#60A5FA" Offset="0.5"/>
                        <GradientStop Color="#1E3A5F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="36,20,36,26">

                <!-- 회전 팬 아이콘 (원 안에) -->
                <Border Width="84" Height="84" CornerRadius="42"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#1D4ED8" Offset="0"/>
                            <GradientStop Color="#0F2747" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <TextBlock Text="🌀" FontSize="40"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="Spin"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Spin"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Border>

                <!-- 제목 -->
                <TextBlock Text="환기 중" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock FontFamily="Segoe UI" FontSize="12.5" Foreground="#94A3B8"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0">
                    가스 농도가 안전 수준으로 내려갈 때까지<LineBreak/>환풍기를 가동합니다
                </TextBlock>

                <!-- 정보 카드 (남은 시간 + 가스) -->
                <Border Background="#142B45" CornerRadius="12" Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 남은 시간 -->
                        <StackPanel Grid.Column="0" Margin="0,14" HorizontalAlignment="Center">
                            <TextBlock Text="남은 시간" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RemainText" Text="03:00"
                                       FontFamily="Consolas" FontSize="23" FontWeight="Bold"
                                       Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#26415F"/>

                        <!-- 가스 농도 -->
                        <StackPanel Grid.Column="2" Margin="0,14" HorizontalAlignment="Center">
                            <TextBlock Text="현재 가스 농도" FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock x:Name="GasText" Text="--"
                                           FontFamily="Consolas" FontSize="23" FontWeight="Bold"
                                           Foreground="#FB923C"/>
                                <TextBlock Text=" ppm" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 강제 종료 버튼 -->
                <Button Content="강제 종료" Click="ForceExit_Click"
                        Width="280" Height="100" Margin="0,50,0,0" Cursor="Hand"
                        HorizontalAlignment="Center" Foreground="#CBD5E1"
                        FontFamily="Segoe UI" FontSize="22" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="14" Background="#243B54"
                                    BorderBrush="#37536F" BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#37536F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>